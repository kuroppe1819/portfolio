<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>achike</title>
    <link rel="icon" type="image/jpeg" href="/profile.jpg" />
    <meta property="og:title" content="achike" />
    <meta property="og:description" content="achike のリンク集" />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <main>
      <div class="intro">
        <div class="profile">
          <img class="avatar" src="/profile.jpg" alt="achike" width="240" height="240" />
          <p class="name">achike</p>
          <p class="title">Software Engineer 7+ years</p>
        </div>
        <ul class="products" aria-label="Products">
          <li>
            <a class="product-name" href="https://pokesol.app/" target="_blank" rel="noopener noreferrer">PokeNote</a>
            <span class="product-meta">
              with <a href="https://www.youtube.com/watch?v=qGu446rqov0" target="_blank" rel="noopener noreferrer">@pokesol</a>
            </span>
          </li>
          <li>
            <a class="product-name" href="https://flexbox.kuroppe1819.com/" target="_blank" rel="noopener noreferrer">Flexbox Cheat Site</a>
            <span class="product-meta">
              — <a href="https://b.hatena.ne.jp/entry/s/kuroppe1819.github.io/flexbox-cheat-site/" target="_blank" rel="noopener noreferrer">Hatena Bookmark</a>
            </span>
          </li>
        </ul>
      </div>
      <div class="links">
        <a href="https://github.com/kuroppe1819" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <img src="/github.svg" alt="GitHub" class="link-icon" width="32" height="32" />
        </a>
        <a href="https://x.com/kuroppe1819" target="_blank" rel="noopener noreferrer" aria-label="X">
          <img src="/x.svg" alt="X" class="link-icon" width="32" height="32" />
        </a>
      </div>
    </main>
    <footer>
      <p class="copyright">© 2026 achike. All Rights Reserved.</p>
    </footer>
  </body>
</html>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: #121212;
    color: #eeeeee;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding: 3rem 1.5rem 2rem;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    width: 100%;
    max-width: 720px;
  }

  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #333333;
  }

  .name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .title {
    font-size: 0.875rem;
    color: #eeeeee;
    opacity: 0.6;
    letter-spacing: 0.08em;
  }

  .products {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    list-style: none;
    text-align: center;
  }

  .products li {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .products a {
    text-underline-offset: 0.2em;
    transition: color 0.2s, opacity 0.2s;
  }

  .product-name {
    color: #eeeeee;
    font-weight: 500;
    text-decoration-color: #666666;
  }

  .product-meta {
    color: #999999;
  }

  .product-meta a {
    color: inherit;
    text-decoration-color: #555555;
  }

  .products a:hover,
  .products a:focus-visible {
    color: #ffffff;
    text-decoration-color: currentColor;
  }

  .links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .links a {
    display: flex;
    align-items: center;
    opacity: 0.7;
    transition: opacity 0.2s, transform 0.2s;
  }

  .links a:hover {
    opacity: 1;
    transform: scale(1.2);
  }

  .link-icon {
    width: 28px;
    height: 28px;
    filter: brightness(0) invert(1);
  }

  @media (min-width: 768px) {
    .avatar {
      width: 240px;
      height: 240px;
    }


    .name {
      font-size: 1.5rem;
    }

    .title {
      font-size: 1rem;
    }

    .products li {
      font-size: 1rem;
    }

    .link-icon {
      width: 32px;
      height: 32px;
    }
  }

  footer {
    margin-top: 2rem;
  }

  .copyright {
    font-size: 0.75rem;
    color: #eeeeee;
    opacity: 0.5;
    text-align: center;
  }
</style>
