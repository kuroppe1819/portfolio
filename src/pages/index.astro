<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>achike</title>
    <link rel="icon" type="image/jpeg" href="/profile.jpg" />
    <meta property="og:title" content="achike" />
    <meta property="og:description" content="achike のリンク集" />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <main>
      <div class="intro">
        <div class="profile">
          <img class="avatar" src="/profile.jpg" alt="achike" width="240" height="240" />
          <p class="name">achike</p>
          <p class="title">Software Engineer 7+ years</p>
        </div>
        <table class="products" aria-label="Products and market reception">
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Market reception</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <span class="product-info">
                  <a class="product-link" href="https://pokesol.app/" target="_blank" rel="noopener noreferrer">
                    <span class="product-name">PokeNote</span>
                  </a>
                  <span class="product-context">
                    <span>with</span>
                    <span>@pokesol</span>
                  </span>
                </span>
              </td>
              <td>
                <a class="media-link" href="https://www.youtube.com/watch?v=qGu446rqov0" target="_blank" rel="noopener noreferrer" aria-label="View PokeNote market reception on YouTube" title="YouTube">
                  <img class="media-icon" src="/youtube.svg" alt="" width="24" height="24" />
                </a>
              </td>
            </tr>
            <tr>
              <td>
                <a class="product-link" href="https://flexbox.kuroppe1819.com/" target="_blank" rel="noopener noreferrer">
                  <span class="product-name">Flexbox Cheat Site</span>
                </a>
              </td>
              <td>
                <a class="media-link" href="https://b.hatena.ne.jp/entry/s/kuroppe1819.github.io/flexbox-cheat-site/" target="_blank" rel="noopener noreferrer" aria-label="View Flexbox Cheat Site market reception on Hatena Bookmark" title="Hatena Bookmark">
                  <img class="media-icon media-icon-hatena" src="/hatena-bookmark.svg" alt="" width="20" height="20" />
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="links">
        <a href="https://github.com/kuroppe1819" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <img src="/github.svg" alt="GitHub" class="link-icon" width="32" height="32" />
        </a>
        <a href="https://x.com/kuroppe1819" target="_blank" rel="noopener noreferrer" aria-label="X">
          <img src="/x.svg" alt="X" class="link-icon" width="32" height="32" />
        </a>
      </div>
    </main>
    <footer>
      <p class="copyright">© 2026 achike. All Rights Reserved.</p>
    </footer>
  </body>
</html>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: #121212;
    color: #eeeeee;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding: 3rem 1rem 2rem;
  }

  main {
    --section-gap: 2.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--section-gap);
    width: 100%;
    max-width: 720px;
  }

  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: 100%;
    min-width: 0;
  }

  .avatar {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #333333;
  }

  .name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .title {
    font-size: 0.875rem;
    color: rgb(238 238 238 / 60%);
    letter-spacing: 0.08em;
    text-align: center;
    white-space: nowrap;
    width: max-content;
  }

  .products {
    width: min(100%, 21rem);
    border-collapse: collapse;
    table-layout: fixed;
  }

  .products th {
    padding: 0.625rem 0;
    border-bottom: 1px solid #3a3a3a;
    color: #888888;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-align: left;
    white-space: nowrap;
  }

  .products th:first-child,
  .products td:first-child {
    width: 64%;
    padding-right: 1rem;
  }

  .products th:last-child,
  .products td:last-child {
    width: 36%;
    text-align: right;
  }

  .products td {
    padding: 0.875rem 0;
    border-bottom: 1px solid #2f2f2f;
    vertical-align: middle;
  }

  .product-link {
    color: #eeeeee;
    font-weight: 500;
    line-height: 1.5;
    text-decoration-line: underline;
    text-decoration-color: #666666;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 0.2s;
  }

  .product-info,
  .product-context {
    display: flex;
    align-items: baseline;
  }

  .product-info {
    gap: 0.375rem;
    white-space: nowrap;
  }

  .product-context {
    gap: 0.25rem;
    font-size: 0.875rem;
    color: #888888;
  }

  .product-name {
    color: #eeeeee;
    font-weight: 500;
    white-space: nowrap;
  }

  .media-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    opacity: 0.78;
    transition: opacity 0.2s, transform 0.2s;
  }

  .media-link:hover,
  .media-link:focus-visible {
    opacity: 1;
    transform: translateY(-1px);
  }

  .media-link:focus-visible {
    outline: 1px solid #888888;
    outline-offset: 2px;
  }

  .media-icon {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  .media-icon-hatena {
    width: 1.25rem;
    height: 1.25rem;
  }

  .product-link:hover,
  .product-link:focus-visible {
    color: #ffffff;
    text-decoration-line: underline;
    text-decoration-color: currentColor;
  }

  .links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .links a {
    display: flex;
    align-items: center;
    opacity: 0.7;
    transition: opacity 0.2s, transform 0.2s;
  }

  .links a:hover {
    opacity: 1;
    transform: scale(1.2);
  }

  .link-icon {
    width: 28px;
    height: 28px;
    filter: brightness(0) invert(1);
  }

  @media (min-width: 768px) {
    body {
      padding-inline: 1.5rem;
    }

    .avatar {
      width: 240px;
      height: 240px;
    }


    .name {
      font-size: 1.5rem;
    }

    .title {
      font-size: 1rem;
    }

    .link-icon {
      width: 32px;
      height: 32px;
    }
  }

  footer {
    margin-top: 2rem;
  }

  .copyright {
    font-size: 0.75rem;
    color: #eeeeee;
    opacity: 0.5;
    text-align: center;
  }
</style>
